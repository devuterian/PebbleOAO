config SERVICE_I18N
    bool "Internationalization"
    help
      Internationalization (gettext) runtime support for installed
      language packs. Firmware includes only the English source strings.

if SERVICE_I18N

config SERVICE_I18N_KOREAN
    bool "Built-in Korean and TUMBLED fonts"
    default y if BOARD_OBELIX || BOARD_QEMU_EMERY
    help
      Include Korean strings and Korean/Japanese TUMBLED font subsets
      on Time 2 without changing the flash partition layout.

module = SERVICE_I18N
module-str = Internationalization
source "subsys/logging/Kconfig.template.log_level"

endif
